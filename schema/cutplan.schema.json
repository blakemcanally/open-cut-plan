{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "format": {
      "type": "string",
      "const": "opencutplan"
    },
    "version": {
      "type": "string",
      "pattern": "^\\d+\\.\\d+$"
    },
    "project": {
      "type": "object",
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "units": {
          "type": "string",
          "enum": [
            "in",
            "mm"
          ]
        },
        "notes": {
          "type": "string"
        },
        "created": {
          "type": "string"
        },
        "modified": {
          "type": "string"
        }
      },
      "required": [
        "name",
        "units"
      ],
      "additionalProperties": {}
    },
    "materials": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "name": {
            "type": "string",
            "minLength": 1
          },
          "thickness": {
            "type": "number",
            "exclusiveMinimum": 0
          },
          "grained": {
            "type": "boolean"
          },
          "color": {
            "type": "string"
          }
        },
        "required": [
          "id",
          "name",
          "thickness",
          "grained"
        ],
        "additionalProperties": {}
      }
    },
    "stock": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "material": {
            "type": "string",
            "minLength": 1
          },
          "length": {
            "type": "number",
            "exclusiveMinimum": 0
          },
          "width": {
            "type": "number",
            "exclusiveMinimum": 0
          },
          "quantity": {
            "anyOf": [
              {
                "type": "integer",
                "exclusiveMinimum": 0,
                "maximum": 9007199254740991
              },
              {
                "type": "null"
              }
            ]
          },
          "cost": {
            "type": "number",
            "minimum": 0
          },
          "kind": {
            "type": "string",
            "enum": [
              "sheet",
              "offcut"
            ]
          },
          "trim": {
            "type": "number",
            "minimum": 0
          },
          "enabled": {
            "type": "boolean"
          },
          "name": {
            "type": "string"
          }
        },
        "required": [
          "id",
          "material",
          "length",
          "width",
          "quantity",
          "kind"
        ],
        "additionalProperties": {}
      }
    },
    "parts": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "name": {
            "type": "string",
            "minLength": 1
          },
          "material": {
            "type": "string",
            "minLength": 1
          },
          "length": {
            "type": "number",
            "exclusiveMinimum": 0
          },
          "width": {
            "type": "number",
            "exclusiveMinimum": 0
          },
          "quantity": {
            "type": "integer",
            "exclusiveMinimum": 0,
            "maximum": 10000
          },
          "grain": {
            "type": "string",
            "enum": [
              "length",
              "width",
              "none"
            ]
          },
          "group": {
            "type": "string"
          },
          "notes": {
            "type": "string"
          },
          "design": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "id",
          "name",
          "material",
          "length",
          "width",
          "quantity",
          "grain"
        ],
        "additionalProperties": {}
      }
    },
    "designs": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "name": {
            "type": "string",
            "minLength": 1
          },
          "system": {
            "type": "string",
            "minLength": 1
          },
          "material": {
            "type": "string",
            "minLength": 1
          },
          "quantity": {
            "type": "integer",
            "minimum": 1,
            "maximum": 100
          },
          "width": {
            "anyOf": [
              {
                "type": "object",
                "properties": {
                  "openings": {
                    "minItems": 1,
                    "maxItems": 50,
                    "type": "array",
                    "items": {
                      "type": "number",
                      "exclusiveMinimum": 0
                    }
                  }
                },
                "required": [
                  "openings"
                ],
                "additionalProperties": {}
              },
              {
                "type": "object",
                "properties": {
                  "outside": {
                    "type": "number",
                    "exclusiveMinimum": 0
                  },
                  "cells": {
                    "type": "integer",
                    "minimum": 1,
                    "maximum": 50
                  }
                },
                "required": [
                  "outside",
                  "cells"
                ],
                "additionalProperties": {}
              }
            ]
          },
          "height": {
            "anyOf": [
              {
                "type": "object",
                "properties": {
                  "openings": {
                    "minItems": 1,
                    "maxItems": 50,
                    "type": "array",
                    "items": {
                      "type": "number",
                      "exclusiveMinimum": 0
                    }
                  }
                },
                "required": [
                  "openings"
                ],
                "additionalProperties": {}
              },
              {
                "type": "object",
                "properties": {
                  "outside": {
                    "type": "number",
                    "exclusiveMinimum": 0
                  },
                  "cells": {
                    "type": "integer",
                    "minimum": 1,
                    "maximum": 50
                  }
                },
                "required": [
                  "outside",
                  "cells"
                ],
                "additionalProperties": {}
              }
            ]
          },
          "depth": {
            "type": "number",
            "exclusiveMinimum": 0
          },
          "back": {
            "type": "object",
            "properties": {
              "material": {
                "type": "string",
                "minLength": 1
              }
            },
            "required": [
              "material"
            ],
            "additionalProperties": {}
          },
          "mount": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "id",
          "name",
          "system",
          "material",
          "width",
          "height",
          "depth"
        ],
        "additionalProperties": {}
      }
    },
    "tools": {
      "type": "array",
      "items": {
        "oneOf": [
          {
            "type": "object",
            "properties": {
              "id": {
                "type": "string",
                "minLength": 1
              },
              "name": {
                "type": "string",
                "minLength": 1
              },
              "kerf": {
                "type": "number",
                "minimum": 0
              },
              "enabled": {
                "type": "boolean"
              },
              "type": {
                "type": "string",
                "const": "table-saw"
              },
              "maxRip": {
                "type": "number",
                "exclusiveMinimum": 0
              },
              "maxCrosscut": {
                "type": "number",
                "exclusiveMinimum": 0
              },
              "maxPiece": {
                "type": "object",
                "properties": {
                  "length": {
                    "type": "number",
                    "exclusiveMinimum": 0
                  },
                  "width": {
                    "type": "number",
                    "exclusiveMinimum": 0
                  }
                },
                "required": [
                  "length",
                  "width"
                ],
                "additionalProperties": {}
              }
            },
            "required": [
              "id",
              "name",
              "kerf",
              "enabled",
              "type"
            ],
            "additionalProperties": {}
          },
          {
            "type": "object",
            "properties": {
              "id": {
                "type": "string",
                "minLength": 1
              },
              "name": {
                "type": "string",
                "minLength": 1
              },
              "kerf": {
                "type": "number",
                "minimum": 0
              },
              "enabled": {
                "type": "boolean"
              },
              "type": {
                "type": "string",
                "const": "track-saw"
              },
              "maxCut": {
                "type": "number",
                "exclusiveMinimum": 0
              }
            },
            "required": [
              "id",
              "name",
              "kerf",
              "enabled",
              "type"
            ],
            "additionalProperties": {}
          },
          {
            "type": "object",
            "properties": {
              "id": {
                "type": "string",
                "minLength": 1
              },
              "name": {
                "type": "string",
                "minLength": 1
              },
              "kerf": {
                "type": "number",
                "minimum": 0
              },
              "enabled": {
                "type": "boolean"
              },
              "type": {
                "type": "string",
                "const": "circular-saw"
              },
              "maxCut": {
                "type": "number",
                "exclusiveMinimum": 0
              }
            },
            "required": [
              "id",
              "name",
              "kerf",
              "enabled",
              "type"
            ],
            "additionalProperties": {}
          },
          {
            "type": "object",
            "properties": {
              "id": {
                "type": "string",
                "minLength": 1
              },
              "name": {
                "type": "string",
                "minLength": 1
              },
              "kerf": {
                "type": "number",
                "minimum": 0
              },
              "enabled": {
                "type": "boolean"
              },
              "type": {
                "type": "string",
                "const": "panel-saw"
              },
              "maxCut": {
                "type": "number",
                "exclusiveMinimum": 0
              },
              "maxStages": {
                "type": "integer",
                "exclusiveMinimum": 0,
                "maximum": 9007199254740991
              }
            },
            "required": [
              "id",
              "name",
              "kerf",
              "enabled",
              "type"
            ],
            "additionalProperties": {}
          }
        ]
      }
    },
    "settings": {
      "default": {},
      "type": "object",
      "properties": {
        "features": {
          "default": {},
          "type": "object",
          "properties": {
            "grain": {
              "default": true,
              "type": "boolean"
            },
            "kerf": {
              "default": true,
              "type": "boolean"
            },
            "trim": {
              "default": true,
              "type": "boolean"
            },
            "cutOrder": {
              "default": true,
              "type": "boolean"
            },
            "toolLimits": {
              "default": true,
              "type": "boolean"
            },
            "offcuts": {
              "default": true,
              "type": "boolean"
            },
            "cost": {
              "default": true,
              "type": "boolean"
            },
            "labels": {
              "default": true,
              "type": "boolean"
            },
            "snapping": {
              "default": true,
              "type": "boolean"
            }
          },
          "additionalProperties": {}
        },
        "orderMode": {
          "default": "sheet",
          "type": "string",
          "enum": [
            "sheet",
            "setup"
          ]
        },
        "trim": {
          "default": 0,
          "type": "number",
          "minimum": 0
        },
        "minOffcut": {
          "type": "object",
          "properties": {
            "length": {
              "type": "number",
              "exclusiveMinimum": 0
            },
            "width": {
              "type": "number",
              "exclusiveMinimum": 0
            }
          },
          "required": [
            "length",
            "width"
          ],
          "additionalProperties": {}
        },
        "display": {
          "default": {},
          "type": "object",
          "properties": {
            "inch": {
              "default": 32,
              "enum": [
                8,
                16,
                32,
                64,
                "decimal"
              ]
            },
            "mm": {
              "default": 0.5,
              "type": "number",
              "enum": [
                1,
                0.5,
                0.1
              ]
            }
          },
          "additionalProperties": {}
        },
        "optimizer": {
          "default": {},
          "type": "object",
          "properties": {
            "timeLimitMs": {
              "default": 2000,
              "type": "integer",
              "exclusiveMinimum": 0,
              "maximum": 9007199254740991
            },
            "seed": {
              "type": "integer",
              "minimum": -9007199254740991,
              "maximum": 9007199254740991
            },
            "goal": {
              "default": "cost",
              "type": "string"
            },
            "extraCostPercent": {
              "default": 10,
              "type": "number",
              "minimum": 0,
              "maximum": 100
            }
          },
          "additionalProperties": {}
        },
        "currency": {
          "default": "USD",
          "type": "string",
          "pattern": "^[A-Z]{3}$"
        }
      },
      "additionalProperties": {}
    },
    "plan": {
      "type": "object",
      "properties": {
        "sheets": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string",
                "minLength": 1
              },
              "stock": {
                "type": "string",
                "minLength": 1
              },
              "pinned": {
                "type": "boolean"
              },
              "placements": {
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "part": {
                      "type": "string",
                      "minLength": 1
                    },
                    "copy": {
                      "type": "integer",
                      "minimum": 0,
                      "maximum": 9007199254740991
                    },
                    "x": {
                      "type": "number"
                    },
                    "y": {
                      "type": "number"
                    },
                    "rotated": {
                      "type": "boolean"
                    }
                  },
                  "required": [
                    "part",
                    "copy",
                    "x",
                    "y",
                    "rotated"
                  ],
                  "additionalProperties": {}
                }
              },
              "cuts": {
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "step": {
                      "type": "integer",
                      "exclusiveMinimum": 0,
                      "maximum": 9007199254740991
                    },
                    "stage": {
                      "type": "integer",
                      "exclusiveMinimum": 0,
                      "maximum": 9007199254740991
                    },
                    "axis": {
                      "type": "string",
                      "enum": [
                        "x",
                        "y"
                      ]
                    },
                    "at": {
                      "type": "number"
                    },
                    "from": {
                      "type": "number"
                    },
                    "to": {
                      "type": "number"
                    },
                    "tool": {
                      "type": "string",
                      "minLength": 1
                    },
                    "trim": {
                      "type": "boolean"
                    }
                  },
                  "required": [
                    "step",
                    "stage",
                    "axis",
                    "at",
                    "from",
                    "to"
                  ],
                  "additionalProperties": {}
                }
              }
            },
            "required": [
              "id",
              "stock",
              "placements"
            ],
            "additionalProperties": {}
          }
        }
      },
      "required": [
        "sheets"
      ],
      "additionalProperties": {}
    },
    "extensions": {
      "type": "object",
      "propertyNames": {
        "type": "string"
      },
      "additionalProperties": {}
    }
  },
  "required": [
    "format",
    "version",
    "project",
    "materials",
    "stock",
    "parts",
    "tools"
  ],
  "additionalProperties": {},
  "title": "OpenCutPlan project",
  "description": "A sheet-goods cut plan: parts, stock, tools, settings, and an optional layout. See docs/format.md."
}
